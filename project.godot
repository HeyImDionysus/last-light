; Last Light — native Godot edition. Open this file in Godot 4.7.2.
config_version=5

[application]
config/name="Last Light"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="Carry the fallen stars. Wake the sleeping coast."
config/icon="res://assets/icon.svg"

[autoload]
Profile="*res://scripts/core/profile.gd"
Sound="*res://scripts/core/sound.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.017, 0.026, 0.046, 1)

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"

[audio]
default_bus_layout="res://assets/default_bus_layout.tres"

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Keeper"
3d_physics/layer_3="Shadows"
